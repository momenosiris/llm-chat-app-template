### Login
POST http://localhost:3000/api/auth/callback/credentials
Content-Type: application/x-www-form-urlencoded

csrfToken={{csrfToken}}
email=admin@example.com
password=password123

### Create Lead
POST http://localhost:3000/api/leads
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "newlead@example.com",
  "firstName": "New",
  "lastName": "Lead",
  "tags": ["vip"],
  "optedIn": true,
  "customFields": {"company": "Acme"}
}

### Import CSV
POST http://localhost:3000/api/leads/import
Content-Type: text/csv
Authorization: Bearer {{token}}

< ./samples/leads.csv

### Create Template
POST http://localhost:3000/api/templates
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Promo Email",
  "channel": "email",
  "htmlBody": "<p>Hello {{first_name}}</p>",
  "placeholders": ["{{first_name}}", "{{unsubscribe_url}}"]
}

### Create Send Job
POST http://localhost:3000/api/send
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "channel": "email",
  "templateId": "{{templateId}}",
  "segmentTags": ["newsletter"],
  "filters": {"optedInOnly": true},
  "webhookFlowId": "{{webhookFlowId}}"
}

